# URL-ul de conectare la baza de date Supabase (PostgreSQL)
# ATENȚIE: URL-ul de Supabase trebuie să conțină parola ta!
# Exemplu: postgresql://postgres.abcdefghijk:PAROLA_TA@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@db.supabase.co:5432/postgres

# Cheie secretă pentru JWT (schimbă asta în producție)
SECRET_KEY=very-secret-key-for-dev
