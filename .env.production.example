# ==============================================================================
# Axis AI Platform - Production Environment Configuration (.env.production)
# ==============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=axis_production
POSTGRES_USER=axis_ioss_admin
POSTGRES_PASSWORD=GENERATE_VERY_STRONG_PASSWORD_HERE

# Security & Authentication
SECRET_KEY=GENERATE_64_CHAR_HEX_SECRET_FOR_JWT_ENCRYPTION
ENVIRONMENT=production

# 3rd Party APIs - Fiscal & OSINT
TERMENE_API_KEY=your_termene_ro_api_token
ANAF_API_ENABLED=true

# 3rd Party APIs - eSign Electronic Signature (Namirial Dual-Pass)
NAMIRIAL_API_KEY=your_namirial_live_production_key
NAMIRIAL_API_URL=https://esign.namirial.com/api/v1
NAMIRIAL_WEBHOOK_SECRET=your_namirial_webhook_signature_secret

# GPS Telemetry Hardware Providers (TrackGPS / SafeFleet / Webfleet)
GPS_PROVIDER=TrackGPS
GPS_API_KEY=your_hardware_feed_telemetry_key

# Monitoring & Maintenance
SENTRY_DSN=
UPTIME_ROBOT_HEARTBEAT_URL=
